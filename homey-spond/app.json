{
  "id": "no.staleso.spond",
  "version": "1.2.0",
  "compatibility": ">=12.1.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Spond",
    "no": "Spond"
  },
  "description": {
    "en": "Use your Spond events in Homey Flows",
    "no": "Bruk Spond-arrangementer i Homey Flows"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "author": {
    "name": "staleso"
  },
  "flow": {
    "triggers": [
      {
        "id": "event_upcoming",
        "title": {
          "en": "An event starts soon",
          "no": "Et arrangement starter snart"
        },
        "titleFormatted": {
          "en": "An event starts within [[minutes]] minutes",
          "no": "Et arrangement starter innen [[minutes]] minutter"
        },
        "args": [
          {
            "name": "minutes",
            "type": "number",
            "min": 5,
            "max": 10080,
            "step": 5,
            "placeholder": {
              "en": "60"
            }
          }
        ],
        "tokens": [
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title",
              "no": "Tittel"
            },
            "example": "Trening"
          },
          {
            "name": "group",
            "type": "string",
            "title": {
              "en": "Group",
              "no": "Gruppe"
            },
            "example": "G12 Fotball"
          },
          {
            "name": "start",
            "type": "string",
            "title": {
              "en": "Start",
              "no": "Start"
            },
            "example": "24.11.2026, 18:00"
          },
          {
            "name": "location",
            "type": "string",
            "title": {
              "en": "Location",
              "no": "Sted"
            },
            "example": "Kunstgressbanen"
          },
          {
            "name": "description",
            "type": "string",
            "title": {
              "en": "Description",
              "no": "Beskrivelse"
            },
            "example": "Husk drikkeflaske"
          }
        ]
      },
      {
        "id": "event_new",
        "title": {
          "en": "A new event was added",
          "no": "Et nytt arrangement er lagt til"
        },
        "tokens": [
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title",
              "no": "Tittel"
            },
            "example": "Kamp"
          },
          {
            "name": "group",
            "type": "string",
            "title": {
              "en": "Group",
              "no": "Gruppe"
            },
            "example": "G12 Fotball"
          },
          {
            "name": "start",
            "type": "string",
            "title": {
              "en": "Start",
              "no": "Start"
            },
            "example": "30.11.2026, 12:00"
          },
          {
            "name": "location",
            "type": "string",
            "title": {
              "en": "Location",
              "no": "Sted"
            },
            "example": "Bortebane"
          },
          {
            "name": "description",
            "type": "string",
            "title": {
              "en": "Description",
              "no": "Beskrivelse"
            },
            "example": "Husk drikkeflaske"
          }
        ]
      },
      {
        "id": "daily_summary",
        "title": {
          "en": "Today's summary is ready",
          "no": "Dagens oppsummering er klar"
        },
        "hint": {
          "en": "Fires when the action 'Create today's summary' runs.",
          "no": "Kjøres når handlingen «Lag dagens oppsummering» kjøres."
        },
        "tokens": [
          {
            "name": "text",
            "type": "string",
            "title": {
              "en": "Summary",
              "no": "Oppsummering"
            },
            "example": "I dag har du 1 Spond-arrangement. Klokken 18:00: Trening, G12 Fotball, på Kunstgressbanen."
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Number of events",
              "no": "Antall arrangementer"
            },
            "example": 1
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "has_event_today",
        "title": {
          "en": "There is !{{an|no}} event today",
          "no": "Det er !{{et|ikke noe}} arrangement i dag"
        }
      },
      {
        "id": "has_event_within",
        "title": {
          "en": "There is !{{an|no}} event soon",
          "no": "Det er !{{et|ikke noe}} arrangement snart"
        },
        "titleFormatted": {
          "en": "There is !{{an|no}} event within [[hours]] hours",
          "no": "Det er !{{et|ikke noe}} arrangement innen [[hours]] timer"
        },
        "args": [
          {
            "name": "hours",
            "type": "number",
            "min": 1,
            "max": 336,
            "step": 1,
            "placeholder": {
              "en": "3"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "refresh",
        "title": {
          "en": "Refresh Spond events",
          "no": "Oppdater Spond-arrangementer"
        }
      },
      {
        "id": "create_daily_summary",
        "title": {
          "en": "Create today's summary",
          "no": "Lag dagens oppsummering"
        }
      }
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#1F8A52",
  "widgets": {
    "upcoming": {
      "id": "upcoming",
      "name": {
        "en": "Spond events",
        "no": "Spond-arrangementer"
      },
      "height": 240,
      "transparent": false,
      "settings": [
        {
          "id": "days",
          "type": "dropdown",
          "title": {
            "en": "Show",
            "no": "Vis"
          },
          "value": "7",
          "values": [
            {
              "id": "1",
              "title": {
                "en": "Today",
                "no": "I dag"
              }
            },
            {
              "id": "7",
              "title": {
                "en": "Next 7 days",
                "no": "Neste 7 dager"
              }
            },
            {
              "id": "14",
              "title": {
                "en": "Next 14 days",
                "no": "Neste 14 dager"
              }
            }
          ]
        }
      ],
      "api": {
        "getEvents": {
          "method": "GET",
          "path": "/events"
        }
      }
    }
  }
}